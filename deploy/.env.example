# Production settings for docker-compose.prod.yml. Copy to deploy/.env, fill in,
# and keep it out of version control (it holds the database password and keys).

# ---- the site ----
HR_DOMAIN=support.example.edu
HR_SCHOOL_NAME=Halverson Ridge High School
HR_TERM=Fall 2026
# Optional modules beside student support: registrar, stockroom, finance, manager, all.
HR_MODULES=
HR_CORS_ORIGINS=https://support.example.edu

# ---- secrets (generate: python -c "import secrets; print(secrets.token_urlsafe(48))") ----
HR_SECRET_KEY=
POSTGRES_PASSWORD=

POSTGRES_USER=halverson
POSTGRES_DB=halverson

# ---- sign-in through the school's identity provider ----
HR_OIDC_ISSUER=
HR_OIDC_CLIENT_ID=
HR_OIDC_CLIENT_SECRET=
HR_OIDC_REDIRECT_URI=https://support.example.edu/api/auth/oidc/callback
# Once everyone signs in through the identity provider:
HR_PASSWORD_LOGIN=true

# ---- the local model ----
# The Ollama compose profile (http://ollama:11434), or a GPU machine on the school network.
HR_OLLAMA_URL=http://ollama:11434
HR_OLLAMA_MODEL=qwen3:4b

# ---- operations ----
HR_SNAPSHOT_HOUR=17
HR_SENTRY_DSN=
# Where nightly database dumps are written on the host, and how many days to keep.
HR_BACKUP_DIR=./backups
HR_BACKUP_KEEP_DAYS=14
HR_BACKUP_HOUR=2
