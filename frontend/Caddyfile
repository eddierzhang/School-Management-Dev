# HR_DOMAIN is the site's public name (support.school.edu). Caddy gets and renews
# its certificate automatically. With "localhost" it uses its own local CA.
{$HR_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Inline style attributes are used by the interface; scripts are only our own.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Uploads: documents are capped at 10 MB and roster imports at 50 MB by the API.
	request_body {
		max_size 60MB
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# Agent runs return at once, but a roster import check can take a while.
			transport http {
				read_timeout 5m
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	# Request URIs carry student IDs (/api/students/S-1507), so they are dropped
	# from the access log; the API's own log names routes by template instead.
	log {
		output stdout
		format filter {
			request>uri delete
			request>headers>Cookie delete
			request>headers>Referer delete
			wrap json
		}
	}
}
