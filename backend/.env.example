# Copy to backend/.env for local development. Every setting is optional.

HR_APP_ENV=development

# SQLite by default. For Postgres (docker compose up -d db):
# HR_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/educationhack
HR_DATABASE_URL=sqlite:///./halverson.db
HR_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# The demo term is generated around this date; the seed requires it. Leave it
# unset in a real deployment so "today" is the real date.
HR_TODAY=2026-09-12
HR_TERM=Fall 2026
HR_SCHOOL_NAME=Halverson Ridge High School

HR_OLLAMA_URL=http://localhost:11434
HR_OLLAMA_MODEL=qwen3:4b
HR_OLLAMA_TIMEOUT=300.0
HR_OLLAMA_TEMPERATURE=0.1
HR_OLLAMA_NUM_CTX=16384
